#!/bin/bash
set -euo pipefail
umask 077
METADATA=http://metadata.google.internal/computeMetadata/v1
WORK=/run/schema-job
metadata() {
  curl --fail --silent --show-error --retry 3 --connect-timeout 5 --max-time 30 \
    -H 'Metadata-Flavor: Google' "$METADATA/$1"
}
finish() {
  local result=$?
  local outcome=failed
  trap - EXIT
  [[ "$result" -ne 0 ]] || outcome=success
  rm -rf "$WORK"
  if ! curl --fail --silent --show-error --retry 3 --connect-timeout 5 --max-time 30 \
    -X PUT -H 'Metadata-Flavor: Google' --data "$outcome" \
    "$METADATA/instance/guest-attributes/schema/status" >/dev/null 2>&1; then
    result=1
  fi
  exit "$result"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
install -d -m 700 "$WORK"
export DOCKER_CONFIG="$WORK/docker"
install -d -m 700 "$DOCKER_CONFIG"
systemctl start docker
IMAGE=$(metadata instance/attributes/schema-image)
REGISTRY=$(metadata instance/attributes/schema-registry)
PROJECT_ID=$(metadata instance/attributes/schema-project)
SECRET_ID=$(metadata instance/attributes/schema-secret)
DB_HOST=$(metadata instance/attributes/schema-db-host)
DB_NAME=$(metadata instance/attributes/schema-db-name)

for attempt in $(seq 1 12); do
  if metadata instance/service-accounts/default/token \
    | sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | docker login -u oauth2accesstoken --password-stdin "https://$REGISTRY" >/dev/null 2>&1 \
    && docker pull "$IMAGE" >/dev/null 2>&1; then
    break
  fi
  [[ "$attempt" -lt 12 ]] || exit 1
  sleep 10
done
rm -f "$DOCKER_CONFIG/config.json"

for attempt in $(seq 1 12); do
  if docker run --rm --network host --log-driver none --entrypoint node \
    -e "PROJECT_ID=$PROJECT_ID" -e "SECRET_ID=$SECRET_ID" \
    -e "DB_HOST=$DB_HOST" -e "DB_NAME=$DB_NAME" "$IMAGE" --input-type=module -e '
    const metadata = "http://metadata.google.internal/computeMetadata/v1/";
    async function get(url, headers) {
      const response = await fetch(url, {headers, signal: AbortSignal.timeout(15000)});
      if (!response.ok) throw new Error("Credential request failed");
      return response.json();
    }
    try {
      const {access_token} = await get(metadata + "instance/service-accounts/default/token", {"Metadata-Flavor":"Google"});
      if (typeof access_token !== "string" || !access_token) throw new Error("Missing token");
      const secret = await get("https://secretmanager.googleapis.com/v1/projects/" + encodeURIComponent(process.env.PROJECT_ID) + "/secrets/" + encodeURIComponent(process.env.SECRET_ID) + "/versions/latest:access", {Authorization: "Bearer " + access_token});
      const payload = JSON.parse(Buffer.from(secret.payload.data, "base64").toString("utf8"));
      const values = {DB_USER: payload.DB_USER, DB_PASSWORD: payload.DB_PASSWORD, DB_HOST: process.env.DB_HOST, DB_NAME: process.env.DB_NAME};
      for (const value of Object.values(values)) {
        if (typeof value !== "string" || !value.length || /[\r\n\x00]/.test(value)) throw new Error("Invalid credential format");
      }
      console.log(Object.entries(values).map(([key, value]) => key + "=" + value).join("\n"));
    } catch {
      console.error("Schema credential initialization failed");
      process.exit(1);
    }
  ' > "$WORK/env.new" 2>/dev/null; then
    break
  fi
  rm -f "$WORK/env.new"
  [[ "$attempt" -lt 12 ]] || exit 1
  sleep 10
done
chmod 600 "$WORK/env.new"
mv "$WORK/env.new" "$WORK/env"
docker run --rm --network host --log-driver none --env-file "$WORK/env" \
  --entrypoint node "$IMAGE" src/db/apply-schema.js >/dev/null 2>&1
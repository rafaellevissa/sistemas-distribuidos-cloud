{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Distributed Cloud environment (nonsecret)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "environment", "profile", "projectId", "region", "hostname", "stateBucket", "storageBucket", "buildServiceAccount", "sizing"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "const": "gcp" },
    "environment": { "enum": ["dev", "prod"] },
    "profile": { "enum": ["economy", "ha"] },
    "productionEnabled": { "type": "boolean" },
    "projectId": { "type": "string", "pattern": "^(?:[a-z][a-z0-9-]{4,28}[a-z0-9]|REPLACE_[A-Z_]+)$" },
    "region": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]+$" },
    "hostname": { "type": "string", "maxLength": 253, "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$|^REPLACE_[A-Z_]+$" },
    "stateBucket": { "type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$|^REPLACE_[A-Z_]+$" },
    "storageBucket": { "type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$|^REPLACE_[A-Z_]+$" },
    "buildServiceAccount": { "type": "string", "pattern": "^[a-z0-9-]+@[^/\\s@]+\\.iam\\.gserviceaccount\\.com$|^REPLACE_[A-Z_]+$" },
    "githubRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minReplicas", "maxReplicas", "dbTier"],
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "dbTier": { "type": "string", "pattern": "^db-[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    }
  }
}
# Disposable local development values only. Never use these in cloud deployments.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=local_api
DB_PASSWORD=local-api-disposable
DB_NAME=aula_pratica_db
STORAGE_PROVIDER=aws
STORAGE_BUCKET=local-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-minio
AWS_SECRET_ACCESS_KEY=local-minio-disposable
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Native GCP: set STORAGE_PROVIDER=gcp and STORAGE_BUCKET, unset S3/AWS settings,
# and use attached service account ADC (no JSON/HMAC keys).